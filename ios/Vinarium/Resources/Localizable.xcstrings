    "Paywall, découverte": {},
    "Paywall, scans épuisés": {},
    "Photographiez une étiquette et la fiche se remplit toute seule. De quoi saisir la cave sans rien taper.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografiere ein Etikett, und die Angaben füllen sich von selbst. Genug, um den Weinkeller ohne Tippen zu füllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photograph a label and the details fill themselves in. Enough to stock the cellar without typing a thing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografía una etiqueta y la ficha se completa sola. Suficiente para llenar la bodega sin escribir nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Photographiez une étiquette et la fiche se remplit toute seule. De quoi saisir la cave sans rien taper."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografa un'etichetta e la scheda si compila da sola. Abbastanza per riempire la cantina senza digitare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ラベルを撮影すれば、情報は自動で入ります。入力なしでセラーを登録できます。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotografe um rótulo e a ficha preenche-se sozinha. O suficiente para encher a adega sem escrever nada."
          }
        }
      }
    },
    "Pils/Lager": {},
