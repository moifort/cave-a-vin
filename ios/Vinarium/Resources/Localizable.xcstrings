{
  "sourceLanguage": "fr",
  "strings": {
    "": {},
    "% vol": {},
    "%@": {},
    "%@ au-delà des nouvelles dimensions. Déplacez-les ou retirez-les d'abord.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ außerhalb der neuen Maße. Sie müssen zuerst verschoben oder entfernt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ beyond the new dimensions. Move or remove them first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fuera de las nuevas dimensiones. Hay que moverlas o retirarlas primero."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oltre le nuove dimensioni. Vanno prima spostate o rimosse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が新しいサイズの範囲外です。先に移動または取り出してください。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ além das novas dimensões. É preciso movê-las ou retirá-las primeiro."
          }
        }
      }
    },
    "%@ n'aura plus accès à la cave commune.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat keinen Zugriff mehr auf den gemeinsamen Weinkeller."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ will no longer have access to the shared cellar."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya no tendrá acceso a la bodega común."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non avrà più accesso alla cantina comune."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は共有セラーにアクセスできなくなります。"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ deixará de ter acesso à adega comum."
          }
        }
      }
    },
