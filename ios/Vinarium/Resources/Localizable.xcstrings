    "Configurons votre cave en quelques étapes : votre prénom et les dimensions de votre cave.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Richten wir deinen Weinkeller in wenigen Schritten ein: dein Vorname und die Maße deines Kellers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let's set up your cellar in a few steps: your first name and your cellar's dimensions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuremos tu bodega en unos pasos: tu nombre y las dimensiones de tu bodega."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuriamo la tua cantina in pochi passi: il tuo nome e le dimensioni della cantina."
          }
