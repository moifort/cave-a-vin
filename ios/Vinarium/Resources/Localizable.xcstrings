    "L'IA n'a rien trouvé à identifier ici. Réessaie avec une photo plus nette.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die KI konnte hier nichts erkennen. Versuche es mit einem schärferen Foto."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AI found nothing to identify here. Try again with a sharper photo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La IA no encontró nada que identificar aquí. Prueba con una foto más nítida."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'IA non ha trovato nulla da identificare. Riprova con una foto più nitida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
